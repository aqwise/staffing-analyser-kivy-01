#:kivy 2.3.1

<MainWindow>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    
    orientation: 'vertical'
    padding: 10
    spacing: 10

    TextInput:
        id: api_key
        hint_text: 'Введите API ключ...'
        size_hint: 1, None
        height: '40dp'
        background_color: 0.2, 0.2, 0.2, 1
        foreground_color: 0.9, 0.9, 0.9, 1
        password: True
        multiline: False
        on_text: root.on_api_key_change(self.text)

    TextInput:
        id: input_text
        hint_text: 'Введите текст для анализа...'
        size_hint: 1, 0.4
        background_color: 0.2, 0.2, 0.2, 1
        foreground_color: 0.9, 0.9, 0.9, 1
        multiline: True
        on_text: root.on_text_input(self, self.text)

    Button:
        id: analyze_btn
        text: 'АНАЛИЗИРОВАТЬ'
        size_hint: 1, None
        height: '48dp'
        disabled: True
        background_color: [0.2, 0.5, 0.9, 1] if not self.disabled else [0.3, 0.3, 0.3, 1]
        on_press: root.on_analyze_press()

    TextInput:
        id: output_text
        hint_text: 'Результат анализа появится здесь...'
        size_hint: 1, 0.6
        background_color: 0.15, 0.15, 0.15, 1
        foreground_color: 0.9, 0.9, 0.9, 1
        readonly: True
        multiline: True