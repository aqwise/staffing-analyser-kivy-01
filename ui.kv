#:kivy 2.3.1
#:import Clipboard kivy.core.clipboard.Clipboard
#:import MarkdownViewer markdown_renderer.MarkdownViewer
#:import get_color_from_hex kivy.utils.get_color_from_hex

<MainWindow>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    orientation: 'vertical'
    padding: 10
    spacing: 10

    # ---------- API-ключ ----------
    TextInput:
        id: api_key
        hint_text: 'Введите API ключ...'
        size_hint: 1, None
        height: '40dp'
        password: True
        multiline: False
        background_color: 0.2, 0.2, 0.2, 1
        foreground_color: 0.9, 0.9, 0.9, 1
        on_text: root.on_api_key_change(self.text)

    # ---------- поле ввода ----------
    TextInput:
        id: input_text
        hint_text: 'Введите текст для анализа...'
        size_hint: 1, 0.4
        multiline: True
        background_color: 0.2, 0.2, 0.2, 1
        foreground_color: 0.9, 0.9, 0.9, 1
        on_text: root.on_text_input(self, self.text)    # ---------- кнопки анализа и примера ----------
    BoxLayout:
        size_hint: 1, None
        height: '48dp'
        spacing: 5
        
        Button:
            id: analyze_btn
            text: 'АНАЛИЗИРОВАТЬ'
            size_hint: 0.8, 1
            disabled: True
            background_color: [0.2, 0.5, 0.9, 1] if not self.disabled else [0.3, 0.3, 0.3, 1]
            on_press: root.on_analyze_press()
            
        Button:
            id: example_btn
            text: 'Пример'
            size_hint: 0.2, 1
            background_color: [0.5, 0.3, 0.7, 1]
            on_press: root.load_example()

    # ---------- слайдер высоты ----------
    BoxLayout:
        size_hint: 1, None
        height: '30dp'

        Label:
            text: 'Размер области вывода:'
            size_hint: 0.35, 1
            color: 0.9, 0.9, 0.9, 1

        Slider:
            id: output_size_slider
            size_hint: 0.55, 1
            min: 0.2
            max: 1.0
            step: 0.05
            value: 0.6
            on_value: root.adjust_output_size(self.value)

        Label:
            id: output_size_label
            text: f"{int(output_size_slider.value * 100)}%"
            size_hint: 0.1, 1
            color: 0.9, 0.9, 0.9, 1

    # ---------- кнопка fullscreen ----------
    Button:
        id: fullscreen_btn
        text: 'На весь экран'
        size_hint: 1, None
        height: '30dp'
        background_color: [0.2, 0.5, 0.2, 1]
        on_press: root.toggle_fullscreen_output()

    # ---------- область вывода + копирование ----------
    BoxLayout:
        id: output_container
        orientation: 'horizontal'
        size_hint: 1, 0.6
        spacing: 5

        # MarkdownViewer для красивого отображения Markdown
        BoxLayout:
            id: viewer_container
            size_hint: 0.9, 1
            canvas.before:
                Color:
                    rgba: 0.12, 0.12, 0.12, 1
                Rectangle:
                    pos: self.pos
                    size: self.size            
            MarkdownViewer:
                id: md_viewer
                markdown_text: 'Результат анализа появится здесь...'
                padding: 10, 10
                
        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.1, 1
            spacing: 2
            
            Button:
                id: copy_btn
                text: 'Markdown'
                size_hint: 1, 0.4
                font_size: '12sp'
                background_color: [0.2, 0.5, 0.9, 1]
                on_press: root.copy_to_clipboard()
            
            Button:
                id: copy_html_btn
                text: 'HTML'
                size_hint: 1, 0.3
                font_size: '12sp'
                background_color: [0.2, 0.6, 0.2, 1]
                on_press: root.copy_as_html()
                
            Button:
                id: copy_rtf_btn
                text: 'RTF/Word'
                size_hint: 1, 0.3  
                font_size: '12sp'
                background_color: [0.9, 0.4, 0.2, 1]
                on_press: root.copy_as_rtf()
